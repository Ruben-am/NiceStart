<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainBab">

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/coordinator_mb"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.google.android.material.bottomappbar.BottomAppBar
            android:id="@+id/bab_mb_menu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            app:fabAlignmentMode="center"
            app:hideOnScroll="true"
            app:menu="@menu/bottom_app_bar_menu"
            app:navigationIcon="@drawable/ic_burger" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fab_mb_add"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/color_surface_blue"
            android:contentDescription="bottom_menu"
            android:src="@drawable/ic_add"
            app:fabSize="normal"

            app:layout_anchor="@+id/bab_mb_menu"

            app:tint="@android:color/white" />
    </androidx.coordinatorlayout.widget.CoordinatorLayout>


</androidx.constraintlayout.widget.ConstraintLayout>